{
  "name": "medconnect-pro",
  "version": "0.11.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:mocks": "cross-env NODE_ENV=development NEXT_PUBLIC_USE_MOCKS=true next dev --turbopack",
    "dev:real": "cross-env NEXT_PUBLIC_USE_MOCKS=false next dev --turbopack",
    "build": "next build",
    "build:mocks": "cross-env NEXT_PUBLIC_USE_MOCKS=true next build",
    "build:production": "cross-env NODE_ENV=production NEXT_PUBLIC_USE_MOCKS=false next build",
    "start": "next start",
    "start:mocks": "cross-env NEXT_PUBLIC_USE_MOCKS=true next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mocks": "vitest run",
    "e2e": "playwright test",
    "e2e:mocks": "playwright test",
    "e2e:ui": "playwright test --ui",
    "clean": "rm -rf .next out dist coverage",
    "reset": "npm run clean && rm -rf node_modules && npm install",
    "plane:sync": "node scripts/plane/sync-tasks.mjs",
    "plane:sync:dry": "node scripts/plane/sync-tasks.mjs --dry-run"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.81.0",
    "@headlessui/react": "^2.2.6",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-big-calendar": "^1.20.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.3.0",
    "react-dropzone": "^20.1.1",
    "react-hook-form": "^7.88.0",
    "react-hot-toast": "^2.5.2",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.0.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run type-check*)",
      "Bash(npm run test*)",
      "Bash(npm run e2e:mocks*)",
      "Bash(npm run openapi:generate)",
      "Bash(npm run plane:sync:dry)",
      "Bash(npx vitest run *)",
      "Bash(npx playwright test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:docs.nestjs.com)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm version *)",
      "Bash(npm run plane:sync)",
      "Bash(npm run migration:run*)",
      "Bash(npm run seed:*)",
      "Bash(npm run reset*)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git stash *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Edit(.github/**)",
      "Edit(infra/**)",
      "Edit(docs/decisions/**)",
      "Edit(package.json)",
      "Edit(apps/*/package.json)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env*.example)",
      "Read(scripts/plane/.env)",
      "Read(*.pem)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.tfvars)",
      "Read(postman/**/*.local.json)",
      "Bash(cat .env*)",
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git tag *)",
      "Bash(rm -rf *)",
      "Bash(npm publish *)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(aws *)",
      "Bash(gh pr merge *)"
    ]
  }
}

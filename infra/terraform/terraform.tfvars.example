# Copy to terraform.tfvars (gitignored) before apply.
# github_repository must match git remote origin: OWNER/REPO, no .git suffix.

aws_region        = "us-east-1"
github_repository = "alexhcj/medconnect-pro"
vpc_cidr          = "10.0.0.0/16"

# CORS. Preview keeps the Amplify hostname pattern so PR hosts can call the preview API.
# Production must be the exact Amplify (or custom) origin from the first green main
# publish — see docs/workflows/deploy.md (Amplify Hosting). Never use
# https://*.amplifyapp.com on production (that pattern also matches previews).
# preview_web_origins     = "https://*.amplifyapp.com"
# production_web_origins  = "https://<amplify-production-origin>"

# First apply before an image exists: api_desired_count = 0, push to ECR, then set 1 and re-apply.
# api_image_tag     = "latest"
# api_desired_count = 1

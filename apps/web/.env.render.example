# Render web placeholders. Do not commit a filled copy. No database URLs.

NEXT_PUBLIC_USE_MOCKS=false
# Same-origin proxy. The browser does not call the API host.
NEXT_PUBLIC_API_BASE_URL=/mcp-api
# Server-only upstream. Render sets this from the API service URL.
API_BASE_URL=https://<api-service>.onrender.com

# Sign-in demo account panel (FE-037). Only the exact value true shows fixture passwords.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true

# Leave NEXT_PUBLIC_OAUTH_ENABLED unset. The public demo hides the provider button.

# Leave NEXT_PUBLIC_DEPLOY_CONTEXT unset. render-web.mjs sets it to pr-preview on a PR preview build only (FE-048).

# Marketing site the auth pages link back to (FE-050). Build-time. render.yaml sets it for medconnect-web.
NEXT_PUBLIC_MARKETING_URL=https://marketing.medconnectpro.app

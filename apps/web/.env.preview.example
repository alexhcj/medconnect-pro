# Preview web placeholders. Amplify injects these on preview branches (INFRA-010).
# Do not commit .env.preview. No database URLs, secret ARNs, or AWS keys.
# Values must equal Terraform output preview_api_url — never production_api_url.

NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_API_BASE_URL=https://<preview-api-https-url>
API_BASE_URL=https://<preview-api-https-url>

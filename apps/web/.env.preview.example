# Preview web placeholders. Amplify injects these on PR preview builds (all-branch
# Amplify env = preview_api_url; main override = production_api_url).
# Do not commit .env.preview. No database URLs, secret ARNs, or AWS keys.
# Values must equal Terraform output preview_api_url — never production_api_url.

NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_API_BASE_URL=https://<preview-api-https-url>
API_BASE_URL=https://<preview-api-https-url>

# Leave NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS unset. Amplify preview and production must not show fixture passwords.
# Leave NEXT_PUBLIC_OAUTH_ENABLED unset. Preview hides the provider button.

# Leave NEXT_PUBLIC_DEPLOY_CONTEXT unset. Only a Render PR preview build sets it (FE-048); Amplify preview and production show no banner.

# NEXT_PUBLIC_MARKETING_URL (FE-050): optional. Set the marketing origin in the Amplify console to show the auth-page logo link; unset renders plain branding.

# Copy to .env.development (and optionally .env.test). Do not commit those copies.
# Hosted preview/production: see .env.preview.example / .env.production.example (placeholders).
# Local never requires cloud credentials. Do not put DATABASE_URL in web env.

# Mock-first local defaults
NEXT_PUBLIC_USE_MOCKS=true
NEXT_PUBLIC_MOCK_DELAY=300
NEXT_PUBLIC_MOCK_ERROR_RATE=0.05
NEXT_PUBLIC_MOCK_LOG_LEVEL=debug

# Server-side BFF proxy to a real API. Unused in mock mode.
# Set when running npm run dev:real after apps/api exists.
# API_BASE_URL=http://localhost:3001

# Browser calls to Nest when NEXT_PUBLIC_USE_MOCKS=false. Defaults to this origin in code.
# Use a path such as /mcp-api only when the web app proxies that path to API_BASE_URL.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Demo OIDC provider button (FE-033). Match the API OIDC_PROVIDER; unset uses the Fake adapter.
# NEXT_PUBLIC_OAUTH_PROVIDER=google

# Provider button (FE-039). Exact true shows the existing button for a local Fake or Google adapter.
# Leave unset on Render, Amplify preview, and production. The public demo hides the button.
# NEXT_PUBLIC_OAUTH_ENABLED=true

# Sign-in demo account panel (FE-037). Only the exact value true shows fixture passwords.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true

# Leave NEXT_PUBLIC_DEPLOY_CONTEXT unset. Only a Render PR preview build sets it (pr-preview); it shows the preview banner (FE-048).

# Marketing site the auth pages link back to (FE-050). Build-time. Unset or non-http(s) shows the logo as plain branding with no link.
NEXT_PUBLIC_MARKETING_URL=http://localhost:3002

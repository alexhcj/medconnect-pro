# Copy to .env.development (and optionally .env.test). Do not commit those copies.

# Mock-first local defaults (recommended until NestJS exists)
NEXT_PUBLIC_USE_MOCKS=true
NEXT_PUBLIC_MOCK_DELAY=300
NEXT_PUBLIC_MOCK_ERROR_RATE=0.05
NEXT_PUBLIC_MOCK_LOG_LEVEL=debug

# Server-side BFF proxy to a real API. Unused in mock mode.
# Set when running npm run dev:real after apps/api exists.
# API_BASE_URL=http://localhost:3001

# Browser calls to Nest when NEXT_PUBLIC_USE_MOCKS=false. Defaults to this origin in code.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

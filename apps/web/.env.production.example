# Production web placeholders. Amplify console injects these on the main branch
# (docs/workflows/deploy.md). Do not commit .env.production.
# No database URLs, secret ARNs, or AWS keys. NEXT_PUBLIC_* is public configuration.
# Values must equal Terraform output production_api_url — never preview_api_url.

NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_API_BASE_URL=https://<production-api-https-url>
API_BASE_URL=https://<production-api-https-url>

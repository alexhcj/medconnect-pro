# Production API placeholders. Copy only if you need a local file; hosted injects env at runtime.
# Do not commit .env.production or secrets. Compose passwords are forbidden here.

APP_ENV=production
NODE_ENV=production
PORT=3001
SWAGGER_UI_ENABLED=false

# Exact production Amplify (or custom) origin only. No localhost. No preview hostname pattern.
# Set after the first Amplify publish (docs/workflows/deploy.md). ECS uses WEB_ORIGINS.
# WEB_ORIGIN=https://<amplify-production-origin>
# WEB_ORIGINS=https://<amplify-production-origin>

# Production document bucket (ECS task role; not a secret).
# DOCUMENT_S3_BUCKET=medconnect-production-documents-<account-id>

# Production/demo RDS. Runtime must be medconnect_app (RLS). Distinct from preview and Compose.
DATABASE_URL=postgresql://<production-runtime-user>:<production-runtime-password>@<production-rds-host>:5432/<production-demo-db>
DATABASE_ADMIN_URL=postgresql://<production-owner-user>:<production-owner-password>@<production-rds-host>:5432/<production-demo-db>

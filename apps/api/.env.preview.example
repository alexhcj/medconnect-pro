# Preview API placeholders. Copy only if you need a local file; hosted injects env at runtime.
# Do not commit .env.preview or secrets. Compose passwords are forbidden here.

APP_ENV=preview
NODE_ENV=production
PORT=3001
SWAGGER_UI_ENABLED=false

# Preview Amplify origin(s). Parser for lists / preview-host patterns is INFRA-008.
# WEB_ORIGIN=https://<amplify-preview-origin>
# WEB_ORIGINS=https://<amplify-preview-origin>

# Preview/demo RDS. Runtime must be medconnect_app (RLS). Distinct from production and Compose.
DATABASE_URL=postgresql://<preview-runtime-user>:<preview-runtime-password>@<preview-rds-host>:5432/<preview-demo-db>
DATABASE_ADMIN_URL=postgresql://<preview-owner-user>:<preview-owner-password>@<preview-rds-host>:5432/<preview-demo-db>

# Copy to .env.development if you need local overrides. Do not commit copies or secrets.
PORT=3001
NODE_ENV=development
# Browser origin allowed to call this API when the Next app runs with mocks off.
# WEB_ORIGIN=http://localhost:3000
# Optional. Defaults to true unless NODE_ENV=production. Hides Swagger UI only; JSON remains at /api/docs-json.
# SWAGGER_UI_ENABLED=true
# Local Compose Postgres (docker compose up -d). Demo credentials only.
# Runtime Nest must use medconnect_app (RLS). Table owner medconnect bypasses RLS — do not point DATABASE_URL at it.
DATABASE_URL=postgresql://medconnect_app:medconnect_app@127.0.0.1:5432/medconnect
DATABASE_ADMIN_URL=postgresql://medconnect:medconnect@127.0.0.1:5432/medconnect
# Local filesystem stand-in for S3 document objects. Tenant-prefixed keys. Do not commit blobs.
# DOCUMENT_STORAGE_DIR=.document-storage

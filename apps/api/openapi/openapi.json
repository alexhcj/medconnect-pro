  "info": {
    "title": "MedConnect Pro API",
    "description": "Generated OpenAPI contract for the MedConnect Pro demonstration API. This is not a HIPAA-certified production system. Examples and fixtures must be synthetic demo data only. Do not put secrets, tokens, or real patient information in this document.",
    "version": "0.17.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "Opaque",
        "type": "http",
        "description": "Opaque mock access token (Authorization: Bearer). Stand-in for a future OAuth 2.0 access token, not a production IdP credential. Platform health and readiness do not require a token. Never commit tokens."
      }
    },
    "schemas": {
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "example": "name"
          },
          "message": {
            "type": "string",
            "example": "Required"
          }
        },
        "required": [
          "path",
          "message"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "Request validation failed"
          },
          "details": {
            "example": [
              {
                "path": "name",
                "message": "Required"
              }
            ],
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            }
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid",
            "example": "00000000-0000-4000-8000-000000000001"
          }
        },
        "required": [
          "error",
          "correlationId"
        ]
      },
      "PatientAddress": {
        "type": "object",
        "properties": {
          "street": {
            "type": "string",
            "example": "100 Demo Street"
          },
          "city": {
            "type": "string",
            "example": "Harborview"
          },
          "state": {
            "type": "string",
            "example": "WA"
          },
          "postalCode": {
            "type": "string",
            "example": "98101"
          }
        },
        "required": [
          "street",
          "city",
          "state",
          "postalCode"
        ]
      },
      "EmergencyContact": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Sky Quinn"
          },
          "relationship": {
            "type": "string",
            "example": "Sibling"
          },
          "phone": {
            "type": "string",
            "example": "555-0101"
          }
        },
        "required": [
          "name",
          "relationship",
          "phone"
        ]
      },
      "PatientInsurance": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "example": "Synthetic Health Plan"
          },
          "policyNumber": {
            "type": "string",
            "example": "SYN-100"
          },
          "groupNumber": {
            "type": "string",
            "example": "GRP-1"
          }
        },
        "required": [
          "provider",
          "policyNumber",
          "groupNumber"
        ]
      },
      "Patient": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "firstName": {
            "type": "string",
            "example": "Avery"
          },
          "lastName": {
            "type": "string",
            "example": "Quinn"
          },
          "dateOfBirth": {
            "type": "string",
            "example": "1988-04-12",
            "description": "ISO date (YYYY-MM-DD)."
          },
          "gender": {
            "type": "string",
            "enum": [
              "female",
              "male",
              "non-binary"
            ],
            "example": "female"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "example": "active"
          },
          "phone": {
            "type": "string",
            "example": "555-0100"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "avery.quinn@synthetic.example"
          },
          "address": {
            "$ref": "#/components/schemas/PatientAddress"
          },
          "emergencyContact": {
            "$ref": "#/components/schemas/EmergencyContact"
          },
          "insurance": {
            "$ref": "#/components/schemas/PatientInsurance"
          },
          "providerId": {
            "type": "string",
            "format": "uuid",
            "description": "User id of the assigned provider in this practice."
          },
          "practiceId": {
            "type": "string",
            "format": "uuid",
            "description": "Server-resolved practice id. Clients must not send this field for authorization."
          },
          "synthetic": {
            "type": "boolean",
            "example": true,
            "description": "Always true. This API stores synthetic demo data only."
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "dateOfBirth",
          "gender",
          "status",
          "phone",
          "email",
          "address",
          "emergencyContact",
          "insurance",
          "providerId",
          "practiceId",
          "synthetic"
        ]
      },
      "PatientSearchResult": {
        "type": "object",
        "properties": {
          "patients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Patient"
            }
          },
          "nextPage": {
            "type": "number",
            "example": 2
          },
          "hasMore": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "patients",
          "hasMore"
        ]
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ],
            "example": "Bearer"
          },
          "accessToken": {
            "type": "string",
            "description": "Opaque mock access token. Stand-in for a future OAuth access token.",
            "example": "opaque-access-token"
          },
          "refreshToken": {
            "type": "string",
            "example": "opaque-refresh-token"
          },
          "expiresIn": {
            "type": "number",
            "example": 900,
            "description": "Access token lifetime in seconds, capped by the absolute session limit."
          }
        },
        "required": [
          "tokenType",
          "accessToken",
          "refreshToken",
          "expiresIn"
        ]
      },
      "MfaChallenge": {
        "type": "object",
        "properties": {
          "mfaRequired": {
            "type": "boolean",
            "enum": [
              true
            ],
            "example": true
          },
          "mfaToken": {
            "type": "string",
            "example": "opaque-mfa-token"
          },
          "expiresIn": {
            "type": "number",
            "example": 300,
            "description": "Seconds until the mock MFA challenge expires."
          }
        },
        "required": [
          "mfaRequired",
          "mfaToken",
          "expiresIn"
        ]
      },
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadyStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ],
            "example": "ready"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}

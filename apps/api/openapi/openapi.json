          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "Request validation failed"
          },
          "details": {
            "example": [
              {
                "path": "name",
                "message": "Required"
              }
            ],
            "type": "array",

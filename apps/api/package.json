{
  "name": "medconnect-api",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src test",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:generate": "nest build && node dist/openapi/generate-openapi.js",
    "migration:run": "nest build && npx typeorm migration:run -d dist/persistence/data-source.js",
    "migration:revert": "nest build && npx typeorm migration:revert -d dist/persistence/data-source.js",
    "seed:mock-identity": "nest build && node dist/identity/seed-mock-identity.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.3",
    "@types/express": "^5.0.3",
    "@types/node": "^24",
    "@types/supertest": "^6.0.3",
    "oxlint": "^1.28.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}

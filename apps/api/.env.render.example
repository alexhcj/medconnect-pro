# Render API placeholders. The Blueprint injects values; do not commit a filled copy.
# APP_ENV=preview is the interim public demo. It is not the future AWS production environment.

APP_ENV=preview
NODE_ENV=production
DOCUMENT_STORAGE_DRIVER=local
PUBLIC_API_PREFIX=/mcp-api
TRUST_PROXY=1
SWAGGER_UI_ENABLED=false
# true only for the first start. Set false after synthetic seed succeeds.
SEED_ON_DEPLOY=true

# Exact public web origin. No wildcard.
WEB_ORIGIN=https://<web-service>.onrender.com

# Owner URL from the Render internal connection string. Runtime URL is derived.
DATABASE_ADMIN_URL=postgresql://<owner-user>:<owner-password>@<internal-host>:5432/medconnect
# Leave unset on Render. start-api.mjs derives postgresql://medconnect_app:<APP_ROLE_PASSWORD>@...
# DATABASE_URL=
APP_ROLE_PASSWORD=<alphanumeric-or-url-safe-secret>
RATE_LIMIT_KEY_SECRET=<at-least-32-characters>

# Optional. Unset keeps the Fake Daily adapter and hosted OAuth unavailable.
# DAILY_API_KEY=
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=

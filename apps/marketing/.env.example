# Public build-time URLs for the static marketing site. Not secrets.
# Local defaults match `next dev --port 3002` and the app on port 3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# API origin for the sign-in wake ping (FE-049). Optional: unset sends no ping. Not a secret.
# NEXT_PUBLIC_API_ORIGIN=http://localhost:3001
# Leave NEXT_PUBLIC_DEPLOY_CONTEXT unset. render-marketing.mjs sets it to pr-preview on a PR preview build only (FE-048).

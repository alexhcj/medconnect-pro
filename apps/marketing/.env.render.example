# Public build-time URLs. Not secrets. Do not commit a filled copy with private hosts.
NEXT_PUBLIC_SITE_URL=https://marketing.medconnectpro.app
NEXT_PUBLIC_APP_ORIGIN=https://medconnectpro.app
# API origin for the sign-in wake ping (FE-049). Public, not a secret.
NEXT_PUBLIC_API_ORIGIN=https://api.medconnectpro.app

# Leave NEXT_PUBLIC_DEPLOY_CONTEXT unset. render-marketing.mjs sets it to pr-preview on a PR preview build only (FE-048).
